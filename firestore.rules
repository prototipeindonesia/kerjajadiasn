rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} { allow read: if request.auth != null; allow write: if false; }
    match /peserta/{code} { allow get, list: if request.auth != null; allow create, update, delete: if isAdmin(); }
    match /pendaftar/{id} { allow create: if request.auth != null; allow read, update, delete: if isAdmin(); }
    match /soal/{id} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /tryout/{id} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /hasil/{id} { allow read: if request.auth != null; allow create: if request.auth != null; allow update, delete: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    
    // Koleksi Baru
    match /voucher/{id} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /produk_digital/{id} { allow read: if true; allow write: if isAdmin(); }
    match /affiliate/{id} { allow read, create: if request.auth != null; allow update, delete: if isAdmin(); }
    match /progress_tryout/{id} { allow read, write: if request.auth != null; } // Peserta bisa baca/tulis progress sendiri
    match /aktivitas/{id} { allow create: if request.auth != null; allow read, delete: if isAdmin(); }
  }
}
